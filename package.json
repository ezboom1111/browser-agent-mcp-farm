{
  "name": "browser-agent-mcp-farm",
  "version": "0.4.0",
  "private": false,
  "type": "module",
  "description": "Playwright BrowserContext farm exposed through MCP tools.",
  "license": "Apache-2.0",
  "author": "이지범 <ezboom1111@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ezboom1111/browser-agent-mcp-farm.git"
  },
  "bugs": {
    "url": "https://github.com/ezboom1111/browser-agent-mcp-farm/issues"
  },
  "homepage": "https://github.com/ezboom1111/browser-agent-mcp-farm#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "playwright",
    "browser-automation",
    "evidence",
    "web-research",
    "anti-hallucination",
    "claim-gate",
    "agent"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "browser-agent-mcp-farm": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "HOST-ADAPTERS.md",
    "AGENTS.md",
    "docs/PRODUCT_DEVELOPMENT_PLAN.md",
    "docs/INFORMATION_SOURCE_TAXONOMY.md",
    "docs/PORTAL_NAVIGATION_ARCHITECTURE.md",
    "docs/PORTAL_NAVIGATION_IMPLEMENTATION_GUIDE.md",
    "docs/OCR.md",
    "docs/OFFICIAL_API.md",
    "docs/SOURCE_STRATEGY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "boundaries": "node scripts/check-boundaries.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify",
    "test": "vitest run",
    "test:ci": "vitest run --coverage --reporter=default --reporter=json --outputFile=.status/vitest-result.json",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/lease-manager.test.ts tests/artifact-writer.test.ts",
    "check:browser": "node scripts/check-browser.mjs",
    "ratchet": "node scripts/ratchet-coverage.mjs",
    "status": "node scripts/generate-status.mjs",
    "scorecard": "node scripts/generate-scorecard.mjs",
    "test:ocr-integration": "vitest run --config vitest.ocr.config.ts",
    "test:official-api": "vitest run --config vitest.official-api.config.ts",
    "smoke": "node ./dist/cli.js smoke",
    "smoke:web": "node ./dist/cli.js smoke-web --timeout-ms 10000",
    "smoke:media": "node ./dist/cli.js smoke-media",
    "smoke:proxy": "node ./dist/cli.js smoke-proxy",
    "test:tarball": "node scripts/test-tarball.mjs",
    "critique:next": "node ./dist/cli.js critique-next",
    "critique:complete": "node ./dist/cli.js critique-complete",
    "evidence:run": "node ./dist/cli.js evidence-run",
    "verify": "npm run build && npm run typecheck && npm run lint && npm run boundaries && npm run check:browser && npm run test:ci && npm run ratchet && npm run smoke && npm run smoke:web && npm run smoke:media && npm run smoke:proxy && npm run test:tarball && npm audit --audit-level=moderate && npm run status && npm run scorecard"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "playwright": "^1.60.0",
    "zod": "^4.1.13"
  },
  "peerDependencies": {
    "tesseract.js": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "tesseract.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.1.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
