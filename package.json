{
  "name": "browser-agent-mcp-farm",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "description": "Playwright BrowserContext farm exposed through MCP tools.",
  "bin": {
    "browser-agent-mcp-farm": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "HOST-ADAPTERS.md",
    "AGENTS.md",
    "docs/PRODUCT_DEVELOPMENT_PLAN.md",
    "docs/INFORMATION_SOURCE_TAXONOMY.md",
    "docs/PORTAL_NAVIGATION_ARCHITECTURE.md",
    "docs/PORTAL_NAVIGATION_IMPLEMENTATION_GUIDE.md",
    "docs/OCR.md",
    "docs/OFFICIAL_API.md",
    "docs/SOURCE_STRATEGY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "boundaries": "node scripts/check-boundaries.mjs",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:ci": "vitest run --coverage --reporter=default --reporter=json --outputFile=.status/vitest-result.json",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/lease-manager.test.ts tests/artifact-writer.test.ts",
    "check:browser": "node scripts/check-browser.mjs",
    "ratchet": "node scripts/ratchet-coverage.mjs",
    "status": "node scripts/generate-status.mjs",
    "test:ocr-integration": "vitest run --config vitest.ocr.config.ts",
    "test:official-api": "vitest run --config vitest.official-api.config.ts",
    "smoke": "node ./dist/cli.js smoke",
    "smoke:web": "node ./dist/cli.js smoke-web --timeout-ms 10000",
    "smoke:media": "node ./dist/cli.js smoke-media",
    "smoke:proxy": "node ./dist/cli.js smoke-proxy",
    "critique:next": "node ./dist/cli.js critique-next",
    "critique:complete": "node ./dist/cli.js critique-complete",
    "evidence:run": "node ./dist/cli.js evidence-run",
    "verify": "npm run build && npm run typecheck && npm run boundaries && npm run check:browser && npm run test:ci && npm run ratchet && npm run smoke && npm run smoke:web && npm run smoke:media && npm run smoke:proxy && npm audit --audit-level=moderate && npm run status"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "playwright": "^1.60.0",
    "zod": "^4.1.13"
  },
  "peerDependencies": {
    "tesseract.js": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "tesseract.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.1.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
